msgid "LocalIndexUpdated"
msgstr ""

#: ../../../events/localindexupdated.rst:4
msgid ""
"Generated when the local index information has changed, due to synchronizing "
"one or more items from the cluster or discovering local changes during a "
"scan."
msgstr ""


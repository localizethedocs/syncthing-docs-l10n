#: ../../../rest/db-override-post.rst:2
msgid "POST /rest/db/override"
msgstr ""

#: ../../../rest/db-override-post.rst:4
msgid ""
"Request override of a send only folder. Override means to make the local "
"version latest, overriding changes made on other devices. This API call does "
"nothing if the folder is not a send only folder."
msgstr ""

#: ../../../rest/db-override-post.rst:8
msgid "Takes the mandatory parameter `folder` (folder ID)."
msgstr ""

#: ../../../rest/db-override-post.rst:10
msgid ""
"curl -X POST -H X-API-key:... http://127.0.0.1:8384/rest/db/override?"
"folder=default"
msgstr ""

#: ../../../rest/debug.rst:2
msgid "Debug Endpoints"
msgstr ""

#: ../../../rest/debug.rst:4
msgid ""
"These endpoints require the :stconf:opt:`gui.debugging` configuration option "
"to be enabled and yield an access denied error code otherwise."
msgstr ""

#: ../../../rest/debug.rst:9
msgid "GET /rest/debug/peerCompletion"
msgstr ""

#: ../../../rest/debug.rst:11
msgid ""
"Summarizes the completion percentage for each remote device.  Returns an "
"object with device IDs as keys and an integer percentage as values."
msgstr ""

#: ../../../rest/debug.rst:16
msgid "GET /rest/debug/httpmetrics"
msgstr ""

#: ../../../rest/debug.rst:18
msgid ""
"Returns statistics about each served REST API endpoint, to diagnose how much "
"time was spent generating the responses."
msgstr ""

#: ../../../rest/debug.rst:23
msgid "GET /rest/debug/cpuprof"
msgstr ""

#: ../../../rest/debug.rst:25
msgid ""
"Used to capture a profile of what Syncthing is doing on the CPU.  See :doc:`/"
"users/profiling`."
msgstr ""

#: ../../../rest/debug.rst:30
msgid "GET /rest/debug/heapprof"
msgstr ""

#: ../../../rest/debug.rst:32
msgid ""
"Used to capture a profile of what Syncthing is doing with the heap memory.  "
"See :doc:`/users/profiling`."
msgstr ""

#: ../../../rest/debug.rst:37
msgid "GET /rest/debug/support"
msgstr ""

#: ../../../rest/debug.rst:39
msgid ""
"Collects information about the running instance for troubleshooting "
"purposes. Returns a \"support bundle\" as a zipped archive, which should be "
"sent to the developers after verifying it contains no sensitive personal "
"information. Credentials for the web GUI and the API key are automatically "
"redacted already."
msgstr ""

#: ../../../rest/debug.rst:46
msgid "GET /rest/debug/file"
msgstr ""

#: ../../../rest/debug.rst:48
msgid ""
"Shows diagnostics about a certain file in a shared folder.  Takes the "
"``folder`` (folder ID) and ``file`` (folder relative path) parameters."
msgstr ""

#: ../../../rest/debug.rst:51
msgid ""
"$ curl -H X-API-Key:... \"http://localhost:8384/rest/debug/file?"
"folder=default&file=foo/bar\""
msgstr ""

#: ../../../rest/debug.rst:55
msgid ""
"The returned object contains the same info as :doc:`db-file-get`, plus a "
"summary of ``globalVersions``."
msgstr ""

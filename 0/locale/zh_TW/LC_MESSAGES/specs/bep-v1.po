msgid "Bits 14-15 (\"Pri\", Priority)"
msgstr ""

#: ../../../specs/bep-v1.rst:471
msgid ""
"indicate the device's upload priority for this folder. Possible values are:"
msgstr ""

#: ../../../specs/bep-v1.rst:0
msgid "00"
msgstr ""

#: ../../../specs/bep-v1.rst:474
msgid "The default. Normal priority."
msgstr ""

#: ../../../specs/bep-v1.rst:0
msgid "01"
msgstr ""

#: ../../../specs/bep-v1.rst:476
msgid ""
"High priority. Other devices SHOULD favour requesting files from this device "
"over devices with normal or low priority."
msgstr ""

#: ../../../specs/bep-v1.rst:0 ../../../specs/bep-v1.rst:1209
msgid "10"
msgstr ""

#: ../../../specs/bep-v1.rst:479
msgid ""
"Low priority. Other devices SHOULD avoid requesting files from this device "
"when they are available from other devices."
msgstr ""

#: ../../../specs/bep-v1.rst:0 ../../../specs/bep-v1.rst:1210
msgid "11"
msgstr ""

#: ../../../specs/bep-v1.rst:482
msgid ""
"Sharing disabled. Other devices SHOULD NOT request files from this device."
msgstr ""

#: ../../../specs/bep-v1.rst:0
msgid "Bits 0 through 14"
msgstr ""

#: ../../../specs/bep-v1.rst:487
msgid "Exactly one of the T and R bits MUST be set."
msgstr ""

#: ../../../specs/bep-v1.rst:489
msgid ""
"The **Options** field contains a list of options that apply to the device."
msgstr ""

#: ../../../specs/bep-v1.rst:496
msgid ""
"struct ClusterConfigMessage {\n"
"    Folder Folders<1000000>;\n"
"    Option Options<64>;\n"
"};\n"

#: ../../../specs/bep-v1.rst:526
msgid "Index (Type = 1) and Index Update (Type = 6)"
msgstr ""

#: ../../../specs/bep-v1.rst:528
msgid ""
"The Index and Index Update messages define the contents of the senders "
"folder. An Index message represents the full contents of the folder and thus "
"supersedes any previous index. An Index Update amends an existing index with "
"new information, not affecting any entries not included in the message. An "
"Index Update MAY NOT be sent unless preceded by an Index, unless a non-zero "
"Max Local Version has been announced for the given folder by the peer device."
msgstr ""


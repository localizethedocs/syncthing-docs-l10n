msgid ""
"{\n"
"    \"id\": 44,\n"
"    \"type\": \"ItemFinished\",\n"
"    \"time\": \"2015-05-27T11:21:05.711133004+02:00\",\n"
"    \"data\": {\n"
"        \"action\": \"update\",\n"
"        \"error\": \"open /Users/jb/src/github.com/syncthing/syncthing/test/"

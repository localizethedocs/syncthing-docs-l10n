#: ../../../events/itemfinished.rst:4
msgid ""
"Generated when Syncthing ends synchronizing a file to a newer version. A "
"successful operation:"
msgstr ""

#: ../../../events/itemfinished.rst:7
msgid ""
"{\n"
"    \"id\": 93,\n"
"    \"type\": \"ItemFinished\",\n"
"    \"time\": \"2014-07-13T21:22:03.414609034+02:00\",\n"
"    \"data\": {\n"
"        \"item\": \"test.txt\",\n"
"        \"folder\": \"default\",\n"
"        \"error\": null,\n"
"        \"type\": \"file\",\n"
"        \"action\": \"update\"\n"
"    }\n"
"}"
msgstr ""


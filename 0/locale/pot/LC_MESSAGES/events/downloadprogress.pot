#: ../../../events/downloadprogress.rst:2
msgid "DownloadProgress"
msgstr ""

#: ../../../events/downloadprogress.rst:4
msgid ""
"Emitted during file downloads for each folder for each file. By default only "
"a single file in a folder is handled at the same time, but custom "
"configuration can cause multiple files to be shown."
msgstr ""


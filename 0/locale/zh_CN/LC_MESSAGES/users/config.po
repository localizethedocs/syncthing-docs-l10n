#: ../../../users/config.rst:144
msgid ""
"One or more ``folder`` elements must be present in the file. Each element "
"describes one folder. The following attributes may be set on the ``folder`` "
"element:"
msgstr ""

#: ../../../users/config.rst:148 ../../../users/config.rst:271
msgid "id"
msgstr ""

#: ../../../users/config.rst:149
msgid "The folder ID, must be unique. (mandatory)"
msgstr ""

#: ../../../users/config.rst:151
msgid "label"
msgstr ""

#: ../../../users/config.rst:152
msgid ""
"The label of a folder is a human readable and descriptive local name. May be "
"different on each device, empty, and/or identical to other folder labels. "
"(optional)"
msgstr ""

#: ../../../users/config.rst:156
msgid "path"
msgstr ""

#: ../../../users/config.rst:157
msgid ""
"The path to the directory where the folder is stored on this device; not "
"sent to other devices. (mandatory)"
msgstr ""

#: ../../../users/config.rst:160
msgid "type"
msgstr ""

#: ../../../users/config.rst:161
msgid "Controls how the folder is handled by Syncthing. Possible values are:"
msgstr ""

#: ../../../users/config.rst:163
msgid "readwrite"
msgstr ""

#: ../../../users/config.rst:164
msgid ""
"The folder is in default mode. Sending local and accepting remote changes."
msgstr ""

#: ../../../users/config.rst:166
msgid "readonly"
msgstr ""

#: ../../../users/config.rst:167
msgid ""
"The folder is in \"master\" mode -- it will not be modified by syncthing on "
"this device."
msgstr ""

#: ../../../users/config.rst:170
msgid "rescanIntervalS"
msgstr ""

#: ../../../users/config.rst:171
msgid ""
"The rescan interval, in seconds. Can be set to zero to disable when external "
"plugins are used to trigger rescans."
msgstr ""

#: ../../../users/config.rst:174
msgid "ignorePerms"
msgstr ""

#: ../../../users/config.rst:175
msgid "True if the folder should ignore permissions."
msgstr ""

#: ../../../users/config.rst:177
msgid "autoNormalize"
msgstr ""

#: ../../../users/config.rst:178
msgid "Automatically correct UTF-8 normalization errors found in file names."
msgstr ""

#: ../../../users/config.rst:180
msgid "The following child elements may exist:"
msgstr ""

#: ../../../users/config.rst:182
msgid "device"
msgstr ""

#: ../../../users/config.rst:183
msgid ""
"These must have the ``id`` attribute and nothing else. Mentioned devices are "
"those that will be sharing the folder in question. Each mentioned device "
"must have a separate ``device`` element later in the file. It is customary "
"that the local device ID is included in all repositories. Syncthing will "
"currently add this automatically if it is not present in the configuration "
"file."
msgstr ""

#: ../../../users/config.rst:190
msgid "minDiskFreePct"
msgstr ""

#: ../../../users/config.rst:191
msgid ""
"The percentage of space that should be available on the disk this folder "
"resides. The folder will be stopped when the percentage of free space goes "
"below the threshold. Set to zero to disable."
msgstr ""

#: ../../../users/config.rst:195
msgid "versioning"
msgstr ""

#: ../../../users/config.rst:196
msgid "Specifies a versioning configuration."
msgstr ""

#: ../../../users/config.rst:199
msgid ":ref:`versioning`"
msgstr ""

#: ../../../users/config.rst:201
msgid "copiers, pullers, hashers"
msgstr ""

#: ../../../users/config.rst:202
msgid ""
"The number of copier, puller and hasher routines to use, or zero for the "
"system determined optimum. These are low level performance options for "
"advanced users only; do not change unless requested to or you've actually "
"read and understood the code yourself. :)"
msgstr ""

#: ../../../users/config.rst:207
msgid "order"
msgstr ""

#: ../../../users/config.rst:208
msgid ""
"The order in which needed files should be pulled from the cluster. The "
"possibles values are:"
msgstr ""

#: ../../../users/config.rst:211
msgid "random"
msgstr ""

#: ../../../users/config.rst:212
msgid ""
"Pull files in random order. This optimizes for balancing resources among the "
"devices in a cluster."
msgstr ""

#: ../../../users/config.rst:215
msgid "alphabetic"
msgstr ""

#: ../../../users/config.rst:216
msgid "Pull files ordered by file name alphabetically."
msgstr ""

#: ../../../users/config.rst:218
msgid "smallestFirst, largestFirst"
msgstr ""

#: ../../../users/config.rst:219
msgid ""
"Pull files ordered by file size; smallest and largest first respectively."
msgstr ""

#: ../../../users/config.rst:221
msgid "oldestFirst, newestFirst"
msgstr ""

#: ../../../users/config.rst:222
msgid ""
"Pull files ordered by modification time; oldest and newest first "
"respectively."
msgstr ""

#: ../../../users/config.rst:225
msgid "ignoreDelete"
msgstr ""

#: ../../../users/config.rst:226
msgid ""
"When set to true, this device will pretend not to see instructions to delete "
"files from other devices."
msgstr ""

#: ../../../users/config.rst:229
msgid "scanProgressIntervalS"
msgstr ""

#: ../../../users/config.rst:230
msgid ""
"The interval with which scan progress information is sent to the GUI. Zero "
"means the default value (two seconds)."
msgstr ""

#: ../../../users/config.rst:233
msgid "pullerSleepS, pullerPauseS"
msgstr ""

#: ../../../users/config.rst:234
msgid ""
"Tweaks for rate limiting the puller. Don't change these unless you know what "
"you're doing."
msgstr ""

#: ../../../users/config.rst:237
msgid "maxConflicts"
msgstr ""

#: ../../../users/config.rst:238
msgid ""
"The maximum number of conflict copies to keep around for any given file. The "
"default, -1, means an unlimited number. Setting this to zero disables "
"conflict copies altogether."
msgstr ""

#: ../../../users/config.rst:242
msgid "disableSparseFiles"
msgstr ""

#: ../../../users/config.rst:243
msgid ""
"By default, blocks containing all zeroes are not written, causing files to "
"be sparse on filesystems that support the concept. When set to true, sparse "
"files will not be created."
msgstr ""

#: ../../../users/config.rst:247
msgid "disableTempIndexes"
msgstr ""

#: ../../../users/config.rst:248
msgid ""
"By default, devices exchange information about blocks available in transfers "
"that are still in progress. When set to true, such information is not "
"exchanged for this folder."
msgstr ""

#: ../../../users/config.rst:254
msgid "Device Element"
msgstr ""

#: ../../../users/config.rst:256
msgid ""
"<device id=\"5SYI2FS-LW6YAXI-JJDYETS-NDBBPIO-256MWBO-XDPXWVG-24QPUM4-"
"PDW4UQU\" name=\"syno\" compression=\"metadata\" introducer=\"false\">\n"
"    <address>dynamic</address>\n"
"</device>\n"
"<device id=\"2CYF2WQ-AKZO2QZ-JAKWLYD-AGHMQUM-BGXUOIS-GYILW34-HJG3DUK-"
"LRRYQAR\" name=\"syno local\" compression=\"metadata\" "
"introducer=\"false\">\n"
"    <address>tcp://192.0.2.1:22001</address>\n"
"</device>"
msgstr ""

#: ../../../users/config.rst:265
msgid ""
"One or more ``device`` elements must be present in the file. Each element "
"describes a device participating in the cluster. It is customary to include "
"a ``device`` element for the local device; Syncthing will currently add one "
"if it is not present. The following attributes may be set on the ``device`` "
"element:"
msgstr ""

#: ../../../users/config.rst:272
msgid ""
"The device ID. This must be written in canonical form, that is without any "
"spaces or dashes. (mandatory)"
msgstr ""

#: ../../../users/config.rst:275
msgid "name"
msgstr ""

#: ../../../users/config.rst:276
msgid "A friendly name for the device. (optional)"
msgstr ""

#: ../../../users/config.rst:278
msgid "compression"
msgstr ""

#: ../../../users/config.rst:279
msgid ""
"Whether to use protocol compression when sending messages to this device. "
"The possible values are:"
msgstr ""

#: ../../../users/config.rst:282
msgid "metadata"
msgstr ""

#: ../../../users/config.rst:283
msgid ""
"Compress metadata packets, such as index information. Metadata is usually "
"very compression friendly so this is a good default."
msgstr ""

#: ../../../users/config.rst:286
msgid "always"
msgstr ""

#: ../../../users/config.rst:287
msgid ""
"Compress all packets, including file data. This is recommended if the "
"folders contents are mainly compressible data such as documents or text "
"files."
msgstr ""

#: ../../../users/config.rst:291
msgid "never"
msgstr ""

#: ../../../users/config.rst:292
msgid "Disable all compression."
msgstr ""

#: ../../../users/config.rst:294
msgid "introducer"
msgstr ""

#: ../../../users/config.rst:295
msgid ""
"Set to true if this device should be trusted as an introducer, i.e. we "
"should copy their list of devices per folder when connecting."
msgstr ""

#: ../../../users/config.rst:298
msgid ""
"In addition, one or more ``address`` child elements must be present. Each "
"contains an address or host name to use when attempting to connect to this "
"device and will be tried in order. Entries other than ``dynamic`` must be "
"prefixed with ``tcp://`` (dual-stack), ``tcp4://`` (IPv4 only) or ``tcp6://` "
"(IPv6 only). Note that IP addresses need not use tcp4/tcp6; these are "
"optional. Accepted formats are:"
msgstr ""

#: ../../../users/config.rst:302
msgid "IPv4 address (``tcp://192.0.2.42``)"
msgstr ""

#: ../../../users/config.rst:303
msgid "The default port (22000) is used."
msgstr ""

#: ../../../users/config.rst:305
msgid "IPv4 address and port (``tcp://192.0.2.42:12345``)"
msgstr ""

#: ../../../users/config.rst:306 ../../../users/config.rst:369
msgid "The address and port is used as given."
msgstr ""

#: ../../../users/config.rst:308
msgid "IPv6 address (``tcp://[2001:db8::23:42]``)"
msgstr ""

#: ../../../users/config.rst:309
msgid ""
"The default port (22000) is used. The address must be enclosed in square "
"brackets."
msgstr ""

#: ../../../users/config.rst:312
msgid "IPv6 address and port (``tcp://[2001:db8::23:42]:12345``)"
msgstr ""

#: ../../../users/config.rst:313 ../../../users/config.rst:372
msgid ""
"The address and port is used as given. The address must be enclosed in "
"square brackets."
msgstr ""

#: ../../../users/config.rst:316
msgid "Host name (``tcp6://fileserver``)"
msgstr ""

#: ../../../users/config.rst:317
msgid ""
"The host name will be used on the default port (22000) and connections will "
"be attempted only via IPv6."
msgstr ""

#: ../../../users/config.rst:319
msgid "Host name and port (``tcp://fileserver:12345``)"
msgstr ""

#: ../../../users/config.rst:320
msgid ""
"The host name will be used on the given port and connections will be "
"attempted via both IPv4 and IPv6, depending on name resolution."
msgstr ""

#: ../../../users/config.rst:322
msgid "``dynamic``"
msgstr ""

#: ../../../users/config.rst:323
msgid ""
"The word ``dynamic`` (without ``tcp://`` prefix) means to use local and "
"global discovery to find the device."
msgstr ""

#: ../../../users/config.rst:327
msgid "IgnoredDevice Element"
msgstr ""

#: ../../../users/config.rst:329
msgid ""
"<ignoredDevice>5SYI2FS-LW6YAXI-JJDYETS-NDBBPIO-256MWBO-XDPXWVG-24QPUM4-"
"PDW4UQU</ignoredDevice>"
msgstr ""

#: ../../../users/config.rst:333
msgid ""
"This optional element lists device IDs that have been specifically ignored. "
"One element must be present for each device ID. Connection attempts from "
"these devices are logged to the console but never displayed in the web GUI."
msgstr ""


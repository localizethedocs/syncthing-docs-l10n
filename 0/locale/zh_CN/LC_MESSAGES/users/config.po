#: ../../../users/config.rst:430
msgid "listenAddress"
msgstr ""

#: ../../../users/config.rst:431
msgid ""
"The listen address for incoming sync connections. See `Listen Addresses`_ "
"for allowed syntax."
msgstr ""

#: ../../../users/config.rst:434
msgid "globalAnnounceServer"
msgstr ""

#: ../../../users/config.rst:435
msgid ""
"A URI to a global announce (discovery) server, or the word ``default`` to "
"include the default servers. Any number of globalAnnounceServer elements may "
"be present. The syntax for non-default entries is that of a HTTP or HTTPS "
"URL. A number of options may be added as query options to the URL: "
"``insecure`` to prevent certificate validation (required for HTTP URLs) and "
"``id=<device ID>`` to perform certificate pinning. The device ID to use is "
"printed by the discovery server on startup."
msgstr ""

#: ../../../users/config.rst:443
msgid "globalAnnounceEnabled"
msgstr ""

#: ../../../users/config.rst:444
msgid ""
"Whether to announce this device to the global announce (discovery) server, "
"and also use it to look up other devices."
msgstr ""

#: ../../../users/config.rst:447
msgid "localAnnounceEnabled"
msgstr ""

#: ../../../users/config.rst:448
msgid ""
"Whether to send announcements to the local LAN, also use such announcements "
"to find other devices."
msgstr ""

#: ../../../users/config.rst:451
msgid "localAnnouncePort"
msgstr ""

#: ../../../users/config.rst:452
msgid "The port on which to listen and send IPv4 broadcast announcements to."
msgstr ""

#: ../../../users/config.rst:454
msgid "localAnnounceMCAddr"
msgstr ""

#: ../../../users/config.rst:455
msgid ""
"The group address and port to join and send IPv6 multicast announcements on."
msgstr ""

#: ../../../users/config.rst:457
msgid "relayServer"
msgstr ""

#: ../../../users/config.rst:458
msgid ""
"Lists one or more relay servers, on the format ``relay://hostname:port``. "
"Alternatively, a relay list can be loaded over https by using an URL like "
"``dynamic+https://somehost/path``. The default loads the list of relays from "
"the relay pool server, ``relays.syncthing.net``."
msgstr ""

#: ../../../users/config.rst:463
msgid "maxSendKbps"
msgstr ""

#: ../../../users/config.rst:464
msgid "Outgoing data rate limit, in kibibytes per second."
msgstr ""

#: ../../../users/config.rst:466
msgid "maxRecvKbps"
msgstr ""

#: ../../../users/config.rst:467
msgid "Incoming data rate limits, in kibibytes per second."
msgstr ""

#: ../../../users/config.rst:469
msgid "reconnectionIntervalS"
msgstr ""

#: ../../../users/config.rst:470
msgid ""
"The number of seconds to wait between each attempt to connect to currently "
"unconnected devices."
msgstr ""

#: ../../../users/config.rst:473
msgid "relaysEnabled"
msgstr ""

#: ../../../users/config.rst:474
msgid ""
"When true, relays will be connected to and potentially used for device to "
"device connections."
msgstr ""

#: ../../../users/config.rst:476
msgid "relayReconnectIntervalM"
msgstr ""

#: ../../../users/config.rst:477
msgid "Sets the interval, in minutes, between relay reconnect attempts."
msgstr ""

#: ../../../users/config.rst:479
msgid "startBrowser"
msgstr ""

#: ../../../users/config.rst:480
msgid ""
"Whether to attempt to start a browser to show the GUI when Syncthing starts."
msgstr ""

#: ../../../users/config.rst:482
msgid "natEnabled"
msgstr ""

#: ../../../users/config.rst:483
msgid ""
"Whether to attempt to perform an UPnP and NAT-PMP port mapping for incoming "
"sync connections."
msgstr ""

#: ../../../users/config.rst:486
msgid "natLeaseMinutes"
msgstr ""

#: ../../../users/config.rst:487
msgid ""
"Request a lease for this many minutes; zero to request a permanent lease."
msgstr ""

#: ../../../users/config.rst:489
msgid "natRenewalMinutes"
msgstr ""

#: ../../../users/config.rst:490
msgid "Attempt to renew the lease after this many minutes."
msgstr ""

#: ../../../users/config.rst:492
msgid "natTimeoutSeconds"
msgstr ""

#: ../../../users/config.rst:493
msgid "When scanning for UPnP devices, wait this long for responses."
msgstr ""

#: ../../../users/config.rst:495
msgid "urAccepted"
msgstr ""

#: ../../../users/config.rst:496
msgid ""
"Whether the user has accepted to submit anonymous usage data. The default, "
"``0``, mean the user has not made a choice, and Syncthing will ask at some "
"point in the future. ``-1`` means no, a number above zero means that that "
"version of usage reporting has been accepted."
msgstr ""

#: ../../../users/config.rst:501
msgid "urUniqueID"
msgstr ""

#: ../../../users/config.rst:502
msgid ""
"The unique ID sent together with the usage report. Generated when usage "
"reporting is enabled."
msgstr ""

#: ../../../users/config.rst:505
msgid "urURL"
msgstr ""

#: ../../../users/config.rst:506
msgid "The URL to post usage report data to, when enabled."
msgstr ""

#: ../../../users/config.rst:508
msgid "urPostInsecurely"
msgstr ""

#: ../../../users/config.rst:509
msgid ""
"When true, the UR URL can be http instead of https, or have a self-signed "
"certificate. The default is ``false``."
msgstr ""

#: ../../../users/config.rst:512
msgid "urInitialDelayS"
msgstr ""

#: ../../../users/config.rst:513
msgid ""
"The time to wait from startup to the first usage report being sent. Allows "
"the system to stabilize before reporting statistics."
msgstr ""

#: ../../../users/config.rst:516
msgid "restartOnWakeup"
msgstr ""

#: ../../../users/config.rst:517
msgid ""
"Whether to perform a restart of Syncthing when it is detected that we are "
"waking from sleep mode (i.e. a folded up laptop)."
msgstr ""

#: ../../../users/config.rst:520
msgid "autoUpgradeIntervalH"
msgstr ""

#: ../../../users/config.rst:521
msgid ""
"Check for a newer version after this many hours. Set to zero to disable "
"automatic upgrades."
msgstr ""

#: ../../../users/config.rst:524
msgid "keepTemporariesH"
msgstr ""

#: ../../../users/config.rst:525
msgid ""
"Keep temporary failed transfers for this many hours. While the temporaries "
"are kept, the data they contain need not be transferred again."
msgstr ""

#: ../../../users/config.rst:528
msgid "cacheIgnoredFiles"
msgstr ""

#: ../../../users/config.rst:529
msgid ""
"Whether to cache the results of ignore pattern evaluation. Performance at "
"the price of memory. Defaults to ``false`` as the cost for evaluating "
"ignores is usually not significant."
msgstr ""

#: ../../../users/config.rst:533
msgid "progressUpdateIntervalS"
msgstr ""

#: ../../../users/config.rst:534
msgid ""
"How often in seconds the progress of ongoing downloads is made available to "
"the GUI."
msgstr ""

#: ../../../users/config.rst:537
msgid "symlinksEnabled"
msgstr ""

#: ../../../users/config.rst:538
msgid "Whether to sync symlinks, if supported by the system."
msgstr ""

#: ../../../users/config.rst:540
msgid "limitBandwidthInLan"
msgstr ""

#: ../../../users/config.rst:541
msgid ""
"Whether to apply bandwidth limits to devices in the same broadcast domain as "
"the local device."
msgstr ""

#: ../../../users/config.rst:544
msgid "databaseBlockCacheMiB"
msgstr ""

#: ../../../users/config.rst:545
msgid ""
"Override the automatically calculated database block cache size. Don't, "
"unless you're very short on memory, in which case you want to set this to "
"``8``."
msgstr ""

#: ../../../users/config.rst:549
msgid "pingTimeoutS"
msgstr ""

#: ../../../users/config.rst:550
msgid ""
"Ping-timeout in seconds. Don't change it unless you are having issues due to "
"slow response time (slow connection/cpu) and large index exchanges."
msgstr ""

#: ../../../users/config.rst:553
msgid "pingIdleTimeS"
msgstr ""

#: ../../../users/config.rst:554
msgid ""
"Ping interval in seconds. Don't change it unless you feel it's necessary."
msgstr ""

#: ../../../users/config.rst:556
msgid "minHomeDiskFreePct"
msgstr ""

#: ../../../users/config.rst:557
msgid ""
"The percentage of space that should be available on the partition holding "
"the configuration and index."
msgstr ""

#: ../../../users/config.rst:560
msgid "releasesURL"
msgstr ""

#: ../../../users/config.rst:561
msgid ""
"The URL from which release information is loaded, for automatic upgrades."
msgstr ""

#: ../../../users/config.rst:563
msgid "overwriteRemoteDeviceNamesOnConnect"
msgstr ""

#: ../../../users/config.rst:564
msgid ""
"If set, device names will always be overwritten with the name given by "
"remote on each connection. By default, the name that the remote device "
"announces will only be adopted when a name has not already been set."
msgstr ""

#: ../../../users/config.rst:568
msgid "tempIndexMinBlocks"
msgstr ""

#: ../../../users/config.rst:569
msgid ""
"When exchanging index information for incomplete transfers, only take into "
"account files that have at least this many blocks."
msgstr ""

#: ../../../users/config.rst:573
msgid "Listen Addresses"
msgstr ""

#: ../../../users/config.rst:575
msgid ""
"The following address types are accepted in sync protocol listen addresses:"
msgstr ""

#: ../../../users/config.rst:577
msgid "TCP wildcard and port (``tcp://0.0.0.0:22000``, ``tcp://:22000``)"
msgstr ""

#: ../../../users/config.rst:578
msgid ""
"These are equivalent and will result in Syncthing listening on all "
"interfaces, IPv4 and IPv6, on the specified port."
msgstr ""

#: ../../../users/config.rst:581
msgid ""
"TCP IPv4 wildcard and port (``tcp4://0.0.0.0:22000``, ``tcp4://:22000``)"
msgstr ""

#: ../../../users/config.rst:582
msgid ""
"These are equivalent and will result in Syncthing listening on all "
"interfaces via IPv4 only."
msgstr ""

#: ../../../users/config.rst:585
msgid "TCP IPv4 address and port (``tcp4://192.0.2.1:22000``)"
msgstr ""

#: ../../../users/config.rst:586 ../../../users/config.rst:594
msgid ""
"These are equivalent and will result in Syncthing listening on the specified "
"address and port only."
msgstr ""

#: ../../../users/config.rst:589
msgid "TCP IPv6 wildcard and port (``tcp6://[::]:22000``, ``tcp6://:22000``)"
msgstr ""

#: ../../../users/config.rst:590
msgid ""
"These are equivalent and will result in Syncthing listening on all "
"interfaces via IPv6 only."
msgstr ""

#: ../../../users/config.rst:593
msgid "TCP IPv6 address and port (``tcp6://[2001:db8::42]:22000``)"
msgstr ""

#: ../../../users/config.rst:597
msgid "Static relay address (``relay://192.0.2.42:22067?id=abcd123...``)"
msgstr ""

#: ../../../users/config.rst:598
msgid ""
"Syncthing will connect to and listen for incoming connections via the "
"specified relay address."
msgstr ""

#: ../../../users/config.rst:601 ../../../users/config.rst:608
msgid "Todo"
msgstr ""

#: ../../../users/config.rst:601 ../../../users/config.rst:608
msgid "Document available URL parameters."
msgstr ""

#: ../../../users/config.rst:603
msgid "Dynamic relay pool (``dynamic+https://192.0.2.42/relays``)"
msgstr ""

#: ../../../users/config.rst:604
msgid ""
"Syncthing will fetch the specified HTTPS URL, parse it for a JSON payload "
"describing relays, select a relay from the available ones and listen via "
"that as if specified as a static relay above."
msgstr ""

#: ../../../users/config.rst:612
msgid "Syncing Configuration files"
msgstr ""

#: ../../../users/config.rst:614
msgid ""
"Syncing configuration files between devices (such that multiple devices are "
"using the same configuration files) can cause issues. This is easy to do "
"accidentally if you sync your home folder between devices. A common symptom "
"of syncing configuration files is two devices ending up with the same Device "
"ID."
msgstr ""

#: ../../../users/config.rst:619
msgid ""
"If you want to use Syncthing to backup your configuration files, it is "
"recommended that the files you are backing up are in a :ref:`folder-master` "
"to prevent other devices from overwriting the per device configuration. The "
"folder on the remote device(s) should not be used as configuration for the "
"remote devices."
msgstr ""

#: ../../../users/config.rst:624
msgid ""
"If you'd like to sync your home folder in non-master mode, you may add the "
"folder that stores the configuration files to the :ref:`ignore list "
"<ignoring-files>`. If you'd also like to backup your configuration files, "
"add another folder in master mode for just the configuration folder."
msgstr ""

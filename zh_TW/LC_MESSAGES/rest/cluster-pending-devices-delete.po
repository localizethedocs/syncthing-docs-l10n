#: ../../../rest/cluster-pending-devices-delete.rst:2
msgid "DELETE /rest/cluster/pending/devices"
msgstr ""

#: ../../../rest/cluster-pending-devices-delete.rst:6
msgid ""
"Remove records about a pending remote device which tried to connect.  Valid "
"values for the ``device`` parameter are those from the corresponding :doc:"
"`cluster-pending-devices-get` endpoint."
msgstr ""

#: ../../../rest/cluster-pending-devices-delete.rst:10
msgid ""
"$ curl -X DELETE -H \"X-API-Key: abc123\" http://localhost:8384/rest/cluster/"
"pending/devices?device=P56IOI7-MZJNU2Y-IQGDREY-DM2MGTI-MGL3BXN-PQ6W5BM-"
"TBBZ4TJ-XZWICQ2"
msgstr ""

#: ../../../rest/cluster-pending-devices-delete.rst:14
msgid ""
"Returns status 200 and no content upon success, or status 500 and a plain "
"text error on failure.  A :doc:`/events/pendingdeviceschanged` event will be "
"generated in response."
msgstr ""

#: ../../../rest/cluster-pending-devices-delete.rst:18
msgid ""
"For a more permanent effect, also for future connections from the same "
"device ID, the device should be ignored in the :doc:`configuration </users/"
"config>` instead."
msgstr ""

#: ../../../rest/system-loglevels-post.rst:2
msgid "POST /rest/system/loglevels"
msgstr ""

#: ../../../rest/system-loglevels-post.rst:6
msgid ""
"Changes the log level for specified facilities. Post an object with the log "
"facilites as keys and desired log level (``DEBUG``, ``INFO``, ``WARN``, or "
"``ERROR``) as the values."
msgstr ""

#: ../../../rest/system-loglevels-post.rst:10
msgid ""
"$ curl -H X-API-Key:abc123 -d '{\"beacon\":\"DEBUG\",\"discovery\":"
"\"WARN\"}' 'http://localhost:8384/rest/system/loglevels'"
msgstr ""

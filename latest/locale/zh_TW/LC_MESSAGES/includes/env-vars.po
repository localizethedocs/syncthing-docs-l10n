#: ../../../includes/env-vars.rst:1
msgid "STTRACE"
msgstr "STTRACE"

#: ../../../includes/env-vars.rst:2
msgid ""
"Used to increase the debugging verbosity in specific facilities, generally "
"mapping to a Go package. Enter a comma-separated string of facilities to "
"trace: ``api,beacon``. Optionally, a log level can be given per facility to "
"specify something other than DEBUG: ``api:WARN,beacon:ERROR``, potentially "
"overriding a global ``--log-level`` adjustment."
msgstr ""


#: ../../../rest/cluster-pending-folders-get.rst:2
msgid "GET /rest/cluster/pending/folders"
msgstr ""

#: ../../../rest/cluster-pending-folders-get.rst:6
msgid ""
"Lists folders which remote devices have offered to us, but are not yet "
"shared from our instance to them.  Takes the optional ``device`` parameter "
"to only return folders offered by a specific remote device. Other offering "
"devices are also omitted from the result."
msgstr ""


#: ../../../rest/db-localchanged-get.rst:2
msgid "GET /rest/db/localchanged"
msgstr ""

#: ../../../rest/db-localchanged-get.rst:6
msgid ""
"Takes one mandatory parameter, ``folder``, and returns the list of files "
"which were changed locally in a receive-only folder.  Thus they differ from "
"the global state and could be reverted by pulling from remote devices again, "
"see :doc:`db-revert-post`."
msgstr ""

#: ../../../rest/db-localchanged-get.rst:11
msgid ""
"The results can be paginated using the :ref:`common pagination parameters "
"<rest-pagination>`."
msgstr ""

#: ../../../rest/db-localchanged-get.rst:14
msgid ""
"{\n"
"  \"files\": [\n"
"    {\n"
"      \"flags\": \"0755\",\n"
"      \"sequence\": 6,\n"
"      \"modified\": \"2015-04-20T23:06:12+09:00\",\n"
"      \"name\": \"ls\",\n"
"      \"size\": 34640,\n"
"      \"version\": [\n"
"        \"5157751870738175669:1\"\n"
"      ]\n"
"    }\n"
"  ],\n"
"  \"page\": 1,\n"
"  \"perpage\": 100\n"
"}"
msgstr ""

#: ../../../rest/db-localchanged-get.rst:33
msgid ""
"This is an expensive call, increasing CPU and RAM usage on the device. Use "
"sparingly."
msgstr ""

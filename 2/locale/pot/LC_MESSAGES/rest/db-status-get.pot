#: ../../../rest/db-status-get.rst:46
msgid "The various fields have the following meaning:"
msgstr ""

#: ../../../rest/db-status-get.rst:48
msgid "global*:"
msgstr ""

#: ../../../rest/db-status-get.rst:49
msgid "Data in the cluster latest version."
msgstr ""

#: ../../../rest/db-status-get.rst:51
msgid "inSync*:"
msgstr ""

#: ../../../rest/db-status-get.rst:52
msgid "Data that is locally the same as the cluster latest version."
msgstr ""

#: ../../../rest/db-status-get.rst:54
msgid "local*:"
msgstr ""

#: ../../../rest/db-status-get.rst:55
msgid ""
"Data that is locally present, regardless of whether it's the same or "
"different version as the cluster latest version."
msgstr ""

#: ../../../rest/db-status-get.rst:57
msgid "need*:"
msgstr ""

#: ../../../rest/db-status-get.rst:58
msgid ""
"Data that is needed to become up to date with the cluster latest version (i."
"e., data that is out of sync)."
msgstr ""

#: ../../../rest/db-status-get.rst:60
msgid "receiveOnlyChanged*:"
msgstr ""

#: ../../../rest/db-status-get.rst:61
msgid ""
"Data that has changed locally in a receive only folder, and thus not been "
"sent to the cluster."
msgstr ""

#: ../../../rest/db-status-get.rst:63
msgid "invalid:"
msgstr ""

#: ../../../rest/db-status-get.rst:64
msgid "Deprecated, always empty."
msgstr ""

#: ../../../rest/db-status-get.rst:66
msgid "pullErrors:"
msgstr ""

#: ../../../rest/db-status-get.rst:67
msgid ""
"The number of files that failed to sync during the last sync operations."
msgstr ""

#: ../../../rest/db-status-get.rst:69
msgid "sequence:"
msgstr ""

#: ../../../rest/db-status-get.rst:70
msgid "The current folder sequence number."
msgstr ""

#: ../../../rest/db-status-get.rst:72
msgid "state:"
msgstr ""

#: ../../../rest/db-status-get.rst:73
msgid "The current folder state."
msgstr ""

#: ../../../rest/db-status-get.rst:75
msgid "stateChanged:"
msgstr ""

#: ../../../rest/db-status-get.rst:76
msgid "When the folder state last changed."
msgstr ""

#: ../../../rest/db-status-get.rst:78
msgid "version:"
msgstr ""

#: ../../../rest/db-status-get.rst:79
msgid "Deprecated, equivalent to the sequence number."
msgstr ""

#: ../../../rest/db-status-get.rst:82
msgid ""
"This is an expensive call, increasing CPU and RAM usage on the device. Use "
"sparingly."
msgstr ""

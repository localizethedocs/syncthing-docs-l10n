#: ../../../rest/system-discovery-post.rst:6
msgid ""
"Post with the query parameters ``device`` and ``addr`` to add entries to the "
"discovery cache."
msgstr ""

#: ../../../rest/system-discovery-post.rst:9
msgid ""
"curl -X POST http://127.0.0.1:8384/rest/system/discovery?"
"device=LGFPDIT7SKNNJVJZA4FC7QNCRKCE753K72BW5QD2FOZ7FRFEP57Q\\&addr=192.162.129.11:22000\n"
"# Or with the X-API-Key header:\n"
"curl -X POST --header \"X-API-Key: TcE28kVPdtJ8COws1JdM0b2nodj77WeQ\" "
"http://127.0.0.1:8384/rest/system/discovery?"
"device=LGFPDIT7SKNNJVJZA4FC7QNCRKCE753K72BW5QD2FOZ7FRFEP57Q\\&addr=192.162.129.11:22000"

#: ../../../events/downloadprogress.rst:65
msgid "``total`` - total number of blocks in the file"
msgstr ""

#: ../../../events/downloadprogress.rst:66
msgid "``pulling`` - number of blocks currently being downloaded"
msgstr ""

#: ../../../events/downloadprogress.rst:67
msgid ""
"``copiedFromOrigin`` - number of blocks copied from the file we are about to "
"replace"
msgstr ""

#: ../../../events/downloadprogress.rst:69
msgid "``reused`` - number of blocks reused from a previous temporary file"
msgstr ""

#: ../../../events/downloadprogress.rst:70
msgid ""
"``copiedFromElsewhere`` - number of blocks copied from other files or "
"potentially other folders"
msgstr ""

#: ../../../events/downloadprogress.rst:72
msgid "``pulled`` - number of blocks actually downloaded so far"
msgstr ""

#: ../../../events/downloadprogress.rst:73
msgid "``bytesTotal`` - approximate total file size"
msgstr ""

#: ../../../events/downloadprogress.rst:74
msgid ""
"``bytesDone`` - approximate number of bytes already handled (already reused, "
"copied or pulled)"
msgstr ""

#: ../../../events/downloadprogress.rst:77
msgid "Where block size is 128KB."
msgstr ""

#: ../../../events/downloadprogress.rst:79
msgid ""
"Files/folders appearing in the event data imply that the download has been "
"started for that file/folder, where disappearing implies that the downloads "
"have been finished or failed for that file/folder. There is always a last "
"event emitted with no data, which implies all downloads have finished/failed."
msgstr ""

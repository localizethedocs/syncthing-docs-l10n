#: ../../../events/remotechangedetected.rst:2
msgid "RemoteChangeDetected"
msgstr "RemoteChangeDetected"

#: ../../../events/remotechangedetected.rst:4
msgid ""
"Generated upon scan whenever a file is locally updated due to a remote "
"change. Files that are updated locally produce a :doc:`localchangedetected` "
"event."
msgstr ""

#: ../../../events/remotechangedetected.rst:7
msgid ""
"This event is not included in :doc:`/rest/events-get` endpoint without a "
"mask specified, but needs to be selected explicitly."
msgstr ""


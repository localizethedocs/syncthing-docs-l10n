#: ../../../users/reverseproxy.rst:4
msgid "Reverse Proxy Setup"
msgstr ""

#: ../../../users/reverseproxy.rst:6
msgid ""
"A reverse proxy allows you to \"pass\" requests through your web server to "
"another site or program. The reverse proxy will make it look like "
"Syncthing's GUI is a page within your existing site."
msgstr ""

#: ../../../users/reverseproxy.rst:10
msgid "This is especially useful if:"
msgstr ""

#: ../../../users/reverseproxy.rst:12
msgid ""
"You need to access the GUI on port 80 or 443 but you already host a website "
"on the same device."
msgstr ""

#: ../../../users/reverseproxy.rst:14
msgid "You want to share SSL certificates with an existing site."
msgstr ""

#: ../../../users/reverseproxy.rst:15
msgid "You want to share authentication with an existing setup."
msgstr ""

#: ../../../users/reverseproxy.rst:18
msgid "Server Configuration"
msgstr ""

#: ../../../users/reverseproxy.rst:20
msgid ""
"If you have access to your web server's configuration use the following "
"examples to pass the location ``/syncthing`` on your web server to "
"Syncthing's GUI hosted on ``localhost:8384``."
msgstr ""

#: ../../../users/reverseproxy.rst:25 ../../../users/reverseproxy.rst:93
msgid "Apache"
msgstr ""

#: ../../../users/reverseproxy.rst:27
msgid ""
"First of all, execute the following command to enable the Apache HTTP Proxy "
"module and the headers module: ``a2enmod proxy_http headers``."
msgstr ""

#: ../../../users/reverseproxy.rst:30
msgid "Then, you may add the following to your Apache httpd configuration:"
msgstr ""

#: ../../../users/reverseproxy.rst:32
msgid ""
"<Location /syncthing/>\n"
"    ProxyPass http://localhost:8384/\n"
"    ProxyPassReverse http://localhost:8384/\n"
"    RequestHeader set \"X-Forwarded-Proto\" expr=%{REQUEST_SCHEME}\n"
"    Require all granted\n"
"</Location>"
msgstr ""

#: ../../../users/reverseproxy.rst:42
msgid "Nginx"
msgstr ""

#: ../../../users/reverseproxy.rst:44
msgid ""
"location /syncthing/ {\n"
"  proxy_set_header        Host $host;\n"
"  proxy_set_header        X-Real-IP $remote_addr;\n"
"  proxy_set_header        X-Forwarded-For $proxy_add_x_forwarded_for;\n"
"  proxy_set_header        X-Forwarded-Proto $scheme;\n"
"\n"
"  proxy_pass              http://localhost:8384/;\n"
"\n"
"  proxy_read_timeout      600s;\n"
"  proxy_send_timeout      600s;\n"
"}"
msgstr ""

#: ../../../users/reverseproxy.rst:59
msgid "Caddy"
msgstr ""

#: ../../../users/reverseproxy.rst:61
msgid ""
"proxy /syncthing localhost:8384 {\n"
"    transparent\n"
"}\n"
"\n"
"timeouts {\n"
"    read none\n"
"    write none\n"
"    header none\n"
"}"
msgstr ""

#: ../../../users/reverseproxy.rst:75
msgid "Caddy v2"
msgstr ""

#: ../../../users/reverseproxy.rst:77
msgid ""
"handle_path /syncthing/* {\n"
"    reverse_proxy http://localhost:8384 {\n"
"            header_up Host {upstream_hostport}\n"
"    }\n"
"}"
msgstr ""

#: ../../../users/reverseproxy.rst:87
msgid "Folder Configuration"
msgstr ""

#: ../../../users/reverseproxy.rst:89
msgid ""
"If you don't have access to your web server configuration files you might "
"try the following technique."
msgstr ""

#: ../../../users/reverseproxy.rst:95
msgid ""
"Add the configuration below to a ``.htaccess`` file in the folder of your "
"webroot which should redirect to the WebUI, ``/syncthing`` to produce the "
"same behaviour as above"
msgstr ""

#: ../../../users/reverseproxy.rst:99
msgid ""
"RewriteEngine On\n"
"RewriteCond %{HTTPS} !=on\n"
"RewriteCond %{ENV:HTTPS} !=on\n"
"RewriteRule .* https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]\n"
"RewriteRule ^(.*) http://localhost:8384/$1 [P]"
msgstr ""

#: ../../../users/reverseproxy.rst:108
msgid ""
"This method also redirects to HTTPS to prevent opening the GUI unencrypted."
msgstr ""

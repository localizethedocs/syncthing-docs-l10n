#: ../../../events/foldercompletion.rst:2
msgid "FolderCompletion"
msgstr ""

#: ../../../events/foldercompletion.rst:4
msgid ""
"The ``FolderCompletion`` event is emitted when the local or remote contents "
"for a folder changes. It contains the completion percentage for a given "
"remote device and is emitted once per currently connected remote device."
msgstr ""


#: ../../../events/localchangedetected.rst:2
msgid "LocalChangeDetected"
msgstr ""

#: ../../../events/localchangedetected.rst:4
msgid ""
"Generated upon scan whenever the local disk has discovered an updated file "
"from the previous scan.  This does *not* include events that are discovered "
"and copied from other devices (:doc:`remotechangedetected`), only files that "
"were changed on the local filesystem."
msgstr ""

#: ../../../events/localchangedetected.rst:9
msgid ""
"This event is not included in :doc:`/rest/events-get` endpoint without a "
"mask specified, but needs to be selected explicitly."
msgstr ""


#: ../../../rest/folder-versions-post.rst:2
msgid "POST /rest/folder/versions"
msgstr ""

#: ../../../rest/folder-versions-post.rst:4
msgid ""
"Restore archived versions of a given set of files.  Expects an object with "
"attributes named after the relative file paths, with timestamps as values "
"matching valid ``versionTime`` entries in the corresponding :doc:`folder-"
"versions-get` response object."
msgstr ""

#: ../../../rest/folder-versions-post.rst:9
msgid ""
"Takes the mandatory parameter ``folder`` (folder ID).  Returns an object "
"containing any error messages that occurred during restoration of the file, "
"with the file path as attribute name."
msgstr ""

#: ../../../rest/folder-versions-post.rst:13
msgid ""
"curl -X POST -H X-API-key:... http://127.0.0.1:8384/rest/folder/versions?"
"folder=default -d '{\n"
"  \"dir1/dir2/bar\": \"2022-02-06T20:44:12+01:00\",\n"
"  \"baz\": \"2022-02-06T20:44:20+01:00\"\n"
"}'"
msgstr ""

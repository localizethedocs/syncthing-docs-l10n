#: ../../../rest/system-config-post.rst:2
msgid "POST /rest/system/config (DEPRECATED)"
msgstr ""

#: ../../../rest/system-config-post.rst:4
msgid ""
"This endpoint still works as before but is deprecated.  Use :doc:`config` "
"instead."
msgstr ""

#: ../../../rest/system-config-post.rst:8
msgid ""
"Post the full contents of the configuration, in the same format as returned "
"by the corresponding GET request. When posting the configuration succeeds, "
"the posted configuration is immediately applied, except for changes that "
"require a restart. Query :ref:`rest-config-insync` to check if a restart is "
"required."
msgstr ""

#: ../../../rest/system-config-post.rst:13
msgid ""
"This endpoint is the main point to control Syncthing, even if the change "
"only concerns a very small part of the config: The usual workflow is to get "
"the config, modify the needed parts and post it again."
msgstr ""

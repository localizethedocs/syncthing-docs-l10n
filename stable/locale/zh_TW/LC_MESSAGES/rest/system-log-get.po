#: ../../../rest/system-log-get.rst:2
msgid "GET /rest/system/log"
msgstr ""

#: ../../../rest/system-log-get.rst:6
msgid ""
"Returns the list of recent log entries.  The optional ``since`` parameter "
"limits the results to message newer than the given timestamp in :rfc:`3339` "
"format."
msgstr ""

#: ../../../rest/system-log-get.rst:9
msgid ""
"{\n"
"  \"messages\": [\n"
"    {\n"
"      \"when\": \"2014-09-18T12:59:26.549953186+02:00\",\n"
"      \"message\": \"This is a log entry\"\n"
"    }\n"
"  ]\n"
"}"
msgstr ""

#: ../../../rest/system-log-get.rst:21
msgid "GET /rest/system/log.txt"
msgstr ""

#: ../../../rest/system-log-get.rst:23
msgid ""
"Returns the same information, formatted as a text log instead of a JSON "
"object."
msgstr ""

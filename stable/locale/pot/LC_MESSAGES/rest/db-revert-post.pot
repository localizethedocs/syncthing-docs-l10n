#: ../../../rest/db-revert-post.rst:2
msgid "POST /rest/db/revert"
msgstr ""

#: ../../../rest/db-revert-post.rst:6
msgid ""
"Request revert of a receive only folder. Reverting a folder means to undo "
"all local changes. This API call does nothing if the folder is not a receive "
"only folder."
msgstr ""

#: ../../../rest/db-revert-post.rst:10
msgid "Takes the mandatory parameter `folder` (folder ID)."
msgstr ""

#: ../../../rest/db-revert-post.rst:12
msgid ""
"curl -X POST -H X-API-Key:... http://127.0.0.1:8384/rest/db/revert?"
"folder=default"
msgstr ""
